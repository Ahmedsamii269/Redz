  if(a==='theme'){const n=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=n;try{localStorage.setItem('redz_theme',n)}catch(x){}render()}
  if(a==='adm'){if(admin)return;modal=true;err='';render();document.getElementById('pw').focus()}
