<!doctype html>
<html lang="en" data-theme="dark"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Redz Recruitment</title>
<style>
:root{--bg:#f4f6f9;--card:#fff;--ink:#101a26;--mut:#617083;--line:#e2e8f0;--red:#f0413a;--red2:#c81e3a;--grad:linear-gradient(135deg,#ff6a3d,#e0243b);--ok:#16a34a;--chip:#eef1f6;--hero:#112b38;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b131c;--card:#121e2a;--ink:#eef2f7;--mut:#8fa0b5;--line:#22354a;--chip:#1a2a3b}}
:root[data-theme="dark"]{--bg:#0b131c;--card:#121e2a;--ink:#eef2f7;--mut:#8fa0b5;--line:#22354a;--chip:#1a2a3b}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 -apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}
.hero{background:radial-gradient(600px 300px at 15% 0,rgba(240,65,58,.28),transparent 70%),radial-gradient(500px 300px at 95% 100%,rgba(255,106,61,.18),transparent 70%),var(--hero);color:#fff;padding:36px 0 78px;position:relative;overflow:hidden}
.top-r{position:absolute;top:16px;right:20px;display:flex;gap:8px;z-index:2}
.top-r button{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:7px 14px;cursor:pointer;font:inherit;font-size:13px;backdrop-filter:blur(6px)}
.hero .wrap{display:flex;align-items:center;gap:28px;flex-wrap:wrap;padding-top:24px}
.logo{width:170px;height:170px;object-fit:cover;border-radius:50%;flex:none;border:3px solid transparent;background:linear-gradient(var(--hero),var(--hero)) padding-box,var(--grad) border-box;box-shadow:0 0 0 7px rgba(255,255,255,.06),0 18px 50px rgba(240,65,58,.45),0 0 90px rgba(255,106,61,.25);transition:transform .3s}
.logo:hover{transform:scale(1.05) rotate(-2deg)}
h1{margin:0;font-size:clamp(30px,6vw,52px);letter-spacing:-1px;line-height:1.05;font-weight:800}
h1 span{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{margin-top:8px;font-size:16px;opacity:.9}.tag{margin-top:2px;letter-spacing:3px;font-size:12px;text-transform:uppercase;opacity:.6}
.cta{display:inline-flex;margin-top:18px;background:var(--grad);color:#fff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:12px;box-shadow:0 10px 26px rgba(240,65,58,.4)}
.stats{display:flex;gap:12px;margin-top:-44px;position:relative;flex-wrap:wrap}
.stat{flex:1 1 140px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 18px;box-shadow:0 10px 30px rgba(0,0,0,.18)}
.stat b{display:block;font-size:26px;line-height:1.1;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.stat span{font-size:12px;color:var(--mut);text-transform:uppercase;letter-spacing:.8px}
.filters{position:sticky;top:env(safe-area-inset-top,0px);z-index:6;margin:14px -20px 0;padding:10px 20px 2px;background:var(--bg);border-bottom:1px solid var(--line)}
.tools{margin:0 0 8px;display:flex;gap:10px;flex-wrap:wrap}
.filters .chips-row{padding:0 0 8px}
.ftoggle{display:none;flex:0 0 auto!important}
.sal{display:inline-flex;align-items:center;gap:6px;align-self:flex-start;font-weight:800;font-size:14px;padding:5px 12px;border-radius:10px;color:var(--red);background:linear-gradient(135deg,rgba(255,106,61,.16),rgba(224,36,59,.12));border:1px solid rgba(240,65,58,.4)}
.tools input,.tools select{flex:1 1 240px;padding:13px 16px;border:1px solid var(--line);border-radius:12px;background:var(--card);color:var(--ink);font:inherit}
.tools select{flex:0 1 200px}
.tools input:focus,.tools select:focus{outline:2px solid var(--red);outline-offset:-1px}
.chips-row{display:flex;gap:8px;overflow-x:auto;padding:4px 0 10px;scrollbar-width:none}
.lg{white-space:nowrap;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:7px 14px;cursor:pointer;font:inherit;font-size:13px}
.lg small{color:var(--mut);margin-left:4px}
.lg.on{background:var(--grad);color:#fff;border-color:transparent}.lg.on small{color:#ffe}
.meta{color:var(--mut);font-size:13px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:6px 0 4px}
.tab{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:5px 12px;cursor:pointer;font:inherit;font-size:13px}
.tab.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.sec{display:flex;align-items:center;gap:10px;margin:26px 0 12px;font-size:20px;font-weight:800}
.sec i{font-style:normal;font-size:24px}.sec small{font-weight:600;font-size:12px;color:var(--mut);background:var(--chip);padding:3px 10px;border-radius:99px}
.sec:after{content:"";flex:1;height:1px;background:var(--line)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;display:flex;flex-direction:column;gap:10px;position:relative;overflow:hidden;transition:border-color .15s;content-visibility:auto;contain-intrinsic-size:320px}
.card:before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--grad)}
.card:hover{border-color:rgba(240,65,58,.5)}
.card.off{opacity:.55}.card.off:before{background:var(--line)}
.top{display:flex;align-items:center;gap:10px}
.av{width:38px;height:38px;border-radius:11px;background:var(--grad);color:#fff;display:grid;place-items:center;font-weight:800;flex:none}
.co{font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--mut);flex:1}
.pill{font-size:11px;padding:3px 9px;border-radius:999px;background:var(--chip);color:var(--mut);font-weight:600}
.pill.on{background:rgba(22,163,74,.16);color:#22c55e}
.card h3{margin:0;font-size:18px;line-height:1.3}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{background:var(--chip);border-radius:8px;padding:2px 9px;font-size:12px;color:var(--mut)}
.chip.hl-yes{background:rgba(22,163,74,.16);color:#16a34a;font-weight:700}
.chip.hl-no{background:rgba(240,65,58,.14);color:#f0413a;font-weight:700}
.body{white-space:pre-wrap;font-size:13.5px;color:var(--ink);opacity:.9;max-height:140px;overflow:hidden;-webkit-mask-image:linear-gradient(#000 65%,transparent);mask-image:linear-gradient(#000 65%,transparent)}
.body.open{max-height:none;-webkit-mask-image:none;mask-image:none}
.more{background:none;border:0;color:var(--red);cursor:pointer;font:inherit;font-size:13px;padding:0;text-align:left;font-weight:600}
.row{display:flex;gap:8px;align-items:center;margin-top:auto;flex-wrap:wrap}
.btn{flex:1;border:0;border-radius:11px;padding:11px 14px;background:var(--grad);color:#fff;font:inherit;font-weight:700;cursor:pointer;text-align:center;text-decoration:none}
.btn:hover{filter:brightness(1.1)}.btn:focus-visible,.lg:focus-visible,.tab:focus-visible,.more:focus-visible{outline:2px solid var(--red);outline-offset:3px}.btn.ok{background:var(--ok)}
.btn.ghost{background:var(--chip);color:var(--ink)}.btn.wa{flex:0 0 auto;background:#25d366;color:#06331a}
.sw{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--mut);cursor:pointer;user-select:none}
.sw input{width:38px;height:22px;appearance:none;background:#5b6b7f;border-radius:99px;position:relative;cursor:pointer;transition:.2s;margin:0}
.sw input:after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.2s}
.sw input:checked{background:var(--ok)}.sw input:checked:after{left:19px}
.empty{text-align:center;color:var(--mut);padding:60px 0}
.bar{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--line);padding:12px 20px calc(12px + env(safe-area-inset-bottom,0px));display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:center;z-index:5;box-shadow:0 -6px 24px rgba(0,0,0,.25)}
.bar input{padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font:inherit;width:170px}
.bar .btn{flex:0 0 auto}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:grid;place-items:center;z-index:9;padding:20px}
.box{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px;width:min(100%,340px);display:flex;flex-direction:column;gap:12px}
.box input,.box textarea{padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font:inherit}
.err{color:var(--red);font-size:13px;min-height:1em}
.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:99px;z-index:20;font-size:14px;max-width:90vw;text-align:center}
.box.wide{width:min(100%,560px);max-height:90vh;overflow:auto}
.box select{padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font:inherit}
.box label{font-size:12px;color:var(--mut)}
.card.urg{border-color:rgba(240,65,58,.75);box-shadow:0 0 0 1px rgba(240,65,58,.35),0 8px 28px rgba(240,65,58,.18)}
.urg-tag{font-size:11px;font-weight:800;letter-spacing:.5px;padding:3px 9px;border-radius:999px;background:var(--grad);color:#fff;animation:blink 1.4s ease-in-out infinite;white-space:nowrap}
@keyframes blink{50%{opacity:.55}}
.urgent-banner{margin:18px 0 4px;padding:14px 16px;border-radius:16px;border:1px solid rgba(240,65,58,.55);background:linear-gradient(135deg,rgba(255,106,61,.16),rgba(224,36,59,.12));display:flex;gap:10px 14px;align-items:center;flex-wrap:wrap}
.urgent-banner b{font-size:15px}
.urgent-banner .lg{border-color:rgba(240,65,58,.55)}
footer{text-align:center;color:var(--mut);font-size:12px;padding:40px 20px 110px}
footer img{width:72px;height:72px;object-fit:cover;border-radius:50%;display:block;margin:0 auto 8px;border:2px solid transparent;background:linear-gradient(var(--bg),var(--bg)) padding-box,var(--grad) border-box}
@media(max-width:560px){.hero .wrap{flex-direction:column;text-align:center}.logo{width:140px;height:140px}
.ftoggle{display:inline-flex}.fsel{display:none}.filters.open .fsel{display:block;flex:1 1 45%}.tools input{flex:1 1 0;min-width:0}}
@media(prefers-reduced-motion:reduce){.urg-tag{animation:none}.logo{transition:none}}
</style>
</head>
