  if(a==='del'){const id=+t.dataset.id;if(delId===id){S.offers=S.offers.filter(o=>o.id!==id);delId=null;dirty=true}else delId=id;render()}
});
const stripE=s=>s.replace(/[\u{1F000}-\u{1FAFF}\u{2600}-\u{27BF}\u{FE0F}\u{200D}]/gu,'').replace(/\s+/g,' ').trim();
function autofill(){
  const t=add.text;if(!t.trim())return;
  if(!add.co){
    const names=[...new Set(S.offers.map(o=>o.company))].sort((a,b)=>b.length-a.length);
    let f='';
    for(const n of names){const b=n.replace(/\s*\(.*?\)/g,'').trim();if(b&&new RegExp('\\b'+b.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\b','i').test(t)){f=n;break}}
    if(!f){const m=t.match(/Company:\s*([^\n]+)/i)||t.match(/([A-Z][\w&.]*(?:\s[A-Z][\w&.]*){0,2}) is hiring/)||t.match(/\bat\s+([A-Z][A-Za-z0-9&. ]{1,30})/);if(m)f=stripE(m[1]).replace(/[:|].*$/,'').trim()}
    add.co=f;
  }
  if(!add.title){
    const m=t.match(/Position:\s*\n?\s*([^\n]+)/i)||t.match(/Job Opening:\s*([^\n]+)/i);
    let l=m?m[1]:(t.split('\n').map(x=>stripE(x)).find(x=>x)||'');
    l=stripE(l).replace(/^(we[’']?re\s+)?(now\s+)?(hiring|job opening|job opportunity|job offer)\s*[:\-–]*\s*/i,'').replace(/\s+at\s+.*$/i,'').trim();
    add.title=l.slice(0,60);
  }
  if(add.lang==='English'){
    const L=[['French',/french|🇫🇷|🇨🇵/i],['German',/german|🇩🇪/i],['Spanish',/spanish|🇪🇸/i],['Italian',/italian|🇮🇹/i],['Dutch',/dutch|🇳🇱/i],['Portuguese',/portuguese|🇵🇹/i],['Arabic',/saudi accent|arabic account/i]];
    add.lang=(L.find(x=>x[1].test(t))||['English'])[0];
  }
  if(!add.loc){
    const m=t.match(/Location\s*:?\s*([^\n]+)/i)||t.match(/📍\s*([^\n]+)/);
    if(m)add.loc=stripE(m[1]).replace(/\(.*?\)/g,'').split(/[,\/|]/)[0].replace(/^(Work\s*)?Location\s*:?\s*/i,'').trim().slice(0,40);
  }
}
function mkTags(co,lang,loc,text){
  const T=['#Hiring','#JobsInEgypt','#CallCenterJobs','#CustomerService','#BPO'];
  const LT={English:['#EnglishJobs'],French:['#FrenchSpeakers','#FrenchJobs'],German:['#GermanSpeakers','#GermanJobs'],Spanish:['#SpanishSpeakers','#SpanishJobs'],Italian:['#ItalianSpeakers','#ItalianJobs'],Dutch:['#DutchSpeakers'],Portuguese:['#PortugueseSpeakers'],Arabic:[]};
  T.push(...(LT[lang]||[]));
  if(/sales/i.test(text))T.push('#Sales');
  const h=x=>'#'+x.replace(/\(.*?\)/g,'').replace(/[^A-Za-z0-9]/g,'');
  if(loc&&h(loc).length>1)T.push(h(loc));
  T.push(h(co),'#RedzRecruitment');
  return [...new Set(T)];
}
function closeAdd(){delete add._dup;addOpen=false;editId=null;addErr='';Object.assign(add,blank())}
function doAdd(){
  if(!add.co||!add.title)autofill();
  if(!add.text.trim()||!add.co||!add.title){addErr='Paste the post and fill Company + Title';render();return}
  const body=add.text.trim().replace(/\n{3,}/g,'\n\n').replace(/(?:\s*#[\w\u0600-\u06FF]+)+\s*$/,'');
  const extra=o=>{['edu','nat','material','confirm','schedule','salary'].forEach(k=>{const v=(add[k]||'').trim();if(v)o[k]=v;else delete o[k]})};
  if(editId!==null){
    const o=S.offers.find(x=>x.id===editId);
    Object.assign(o,{company:add.co.trim(),title:add.title.trim(),lang:add.lang,loc:add.loc.trim(),body});extra(o);
    dirty=true;closeAdd();toast('Offer updated ✓ — click "Copy updated code" to save it');return;
  }
  if(!add._dup&&S.offers.some(o=>o.active&&o.company===add.co.trim()&&o.lang===add.lang&&o.title===add.title.trim())){add._dup=1;addErr='⚠️ في عرض نشط بنفس الشركة واللغة والعنوان — دوس Add تاني لو متأكد';render();return}
  const id=Math.max(-1,...S.offers.map(o=>o.id))+1;
  const o={id,company:add.co.trim(),title:add.title.trim(),lang:add.lang,loc:add.loc.trim(),body,tags:mkTags(add.co,add.lang,add.loc,add.title+' '+body),active:true};
  extra(o);S.offers.push(o);dirty=true;closeAdd();
  toast('Offer added ✓ — click "Copy updated code" to save it');
}
// Build a clean copy of this page from its own source (not from the live DOM).
function buildCode(){
  const css=[...document.querySelectorAll('style')].filter(s=>s.textContent.includes('--bg:')).map(s=>'<style>'+s.textContent+'</style>').join('\n');
  const main=[...document.scripts].find(s=>s.textContent.includes('const LOGO=')).textContent;
  const state=JSON.stringify(Object.assign({},S,{ver:String(Date.now())})).replace(/</g,'\\u003c');
  const X='</'+'script>';
  return '<!doctype html>\n<html lang="en" data-theme="dark"><head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n<title>Redz Recruitment</title>\n'+css+'\n</head>\n<body>\n<script type="application/json" id="state">'+state+X+'\n<div id="app"></div>\n<script>'+main+X+'\n</body></html>';
}
function download(code){const u=URL.createObjectURL(new Blob([code],{type:'text/html'}));const a=document.createElement('a');a.href=u;a.download='redz-recruitment.html';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),2000)}
async function publish(){
  const code=buildCode();
  if(await copy(code))toast('Code copied ✓ — paste it in Google Sites (if paste looks wrong use "Show code")');
  else{codeOut=code;render();const x=document.getElementById('co2');if(x){x.focus();x.select()}}
}
render();
</script>
